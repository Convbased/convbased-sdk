# Convbased voice-conversion app environment — copied to ~/convbased-bt/convbased-app.env
# by setup.sh (chmod 600). Fill API_KEY and MODEL_ID, then:
#   systemctl --user enable --now convbased-app
#
# OUTPUT=pipewire routes the converted track into the convbased_out null sink (which
# convbased-link carries into the Bluetooth HFP uplink). MIC_DEVICE is the USB headset
# capture device — find yours with `arecord -l` (the CARD= name is stable across reboots,
# unlike the numeric index). PITCH is the *starting* pitch shift in semitones (+12 = one
# octave up); the target voice/timbre itself is the MODEL_ID. The web console owns the
# model, conversion parameters, and realtime billing switch. Keep PROFILE_POLL_MS above
# zero so an off device can receive the next enable change. WEBUI_PORT serves a status panel with local
# mute/sidetone controls. WEBUI_HOST selects its bind address. Set WEBUI_TOKEN to require
# a shared secret for those two controls, or leave it empty only on a trusted LAN.
OUTPUT=pipewire
PW_TARGET=convbased_out
MIC_DEVICE=plughw:CARD=Device,DEV=0
RATE=48000
PITCH=12
PROFILE_POLL_MS=20000
WEBUI_PORT=8080
WEBUI_HOST=0.0.0.0
WEBUI_TOKEN=
API_KEY=
MODEL_ID=
