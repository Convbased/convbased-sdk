# Keep LF endings even when checked out / copied from Windows, so shebangs and
# bash/python/node don't choke on CRLF (these run on Linux boards).
.gitattributes text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.md        text eol=lf
*.env.example text eol=lf
**/.editorconfig text eol=lf
